   "name": "הוק: עצירת גלילה וכאב",
   "start": 0,
   "end": 4.34,
   "lines": [
    {
     "start": 0.25,
     "end": 3.89,
     "text": "שוב נשרפה לך כל המכסה בקלוד, אחרי שעה של עבודה?"
    }
   ]
  },
  {
   "id": "agitation",
   "name": "הצפת הכאב",
   "start": 4.34,
   "end": 10.82,
   "lines": [
    {
     "start": 4.34,
     "end": 7.51,
     "text": "אתה משלם עשרים דולר בחודש, נתקע באמצע משימה,"
    },
    {
     "start": 7.96,
     "end": 10.37,
     "text": "ומקבל תשובות גנריות ולא מדויקות."
    }
   ]
  },
  {
   "id": "solution",
   "name": "הערך והפתרון",
   "start": 10.82,
   "end": 25.04,
   "lines": [
    {
     "start": 10.82,
     "end": 12.55,
     "text": "הסוד הוא לעבוד עם שיטה."
    },
    {
     "start": 13,
     "end": 16.69,
     "text": "לדעת מתי לעבוד בשיחה, בעוזר האישי או בקלוד קוד."
    },
    {
     "start": 17.14,
     "end": 20.87,
     "text": "לתכנן עם אופוס ולבצע עם סונט, כדי שהמכסה תחזיק."
    },
    {
     "start": 21.32,
     "end": 24.59,
     "text": "ולהפעיל סקילים שמריצים עבודה שלמה במשפט אחד."
    }
   ]
  },
  {
   "id": "cta",
   "name": "הנעה לפעולה",
   "start": 25.04,
   "end": 35.17,
   "lines": [
    {
     "start": 25.04,
     "end": 29.36,
     "text": "ריכזתי את חמשת כללי הזהב ואת כל המדריך לקלוד קוד במקום אחד."
    },
    {
     "start": 29.81,
     "end": 30.83,
     "text": "חינם לגמרי."
    },
    {
     "start": 31.28,
     "end": 33.77,
     "text": "תגיבו \"קלוד\", והקישור אצלכם בפרטי."
    }
   ]
  }
 ],
