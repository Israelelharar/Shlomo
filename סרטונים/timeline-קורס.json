   ],
   [
    4.9,
    6.05,
    "בפקודה אחת."
   ],
   [
    6.45,
    8.7,
    "הבעיה: | מצב בלי שום הגנה, | שמאשר הכל."
   ],
   [
    9.1,
    10.55,
    "הפתרון: | מצב אוטומטי."
   ],
   [
    10.95,
    13.4,
    "קלוד עובד לבד, | ובודק נפרד | עוצר פעולות מסוכנות."
   ],
   [
    13.8,
    16.25,
    "ושומר מחיקה: | לפני כל מחיקה, | הוא עוצר ושואל."
   ],
   [
    16.65,
    18.2,
    "עובדים מהר, | בלי לפחד."
   ],
   [
    18.6,
    21.65,
    "הקישור בביו."
   ]
  ]
 },
