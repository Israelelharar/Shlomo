   ],
   [
    15.95,
    17.6,
    "בוחרים מודל | בתחילת השיחה."
   ],
   [
    18.0,
    19.85,
    "ככה המכסה | מחזיקה | הרבה יותר."
   ],
   [
    20.25,
    23.3,
    "הקישור בביו."
   ]
  ]
 },
 "3": {
  "duration": 22.0,
  "lines": [
   [
    0.3,
    2.05,
    "פוחדים לתת לקלוד | לגעת במחשב?"
   ],
   [
    2.45,
    4.5,
