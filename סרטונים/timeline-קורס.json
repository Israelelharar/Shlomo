  "lines": [
   [
    0.3,
    2.05,
    "כתבתם לקלוד: | תעשה לי ריל."
   ],
   [
    2.45,
    3.8,
    "קיבלתם משהו | גנרי."
   ],
   [
    4.2,
    5.85,
    "תיקנתם. | ושוב תיקנתם."
   ],
   [
    6.25,
    8.1,
