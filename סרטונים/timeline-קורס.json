   ],
   [
    20.25,
    22.1,
    "בקשה אחת | במקום | שבעה תיקונים."
   ],
   [
    22.5,
    25.55,
    "הקישור בביו."
   ]
  ]
 },
 "2": {
  "duration": 23.65,
  "lines": [
   [
    0.3,
    2.15,
    "באמצע הסרטון, | נגמרה המכסה."
   ],
   [
    2.55,
    4.1,
