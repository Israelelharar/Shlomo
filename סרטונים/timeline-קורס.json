   ],
   [
    8.8,
    10.85,
    "והמודל הכי כבד | גם לשאלה | הכי קטנה."
   ],
   [
    11.25,
    13.1,
    "הפתרון: | נושא חדש, | שיחה חדשה."
   ],
   [
    13.5,
    15.55,
