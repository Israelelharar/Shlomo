   ],
   [
    8.5,
    9.95,
    "הבעיה היא | לא קלוד."
   ],
   [
    10.35,
    12.4,
    "מה שלא אמרתם, | הוא ממלא | בממוצע."
   ],
   [
    12.8,
    14.55,
    "הפתרון: | 5 דברים | בכל בקשה."
   ],
   [
    14.95,
    17.2,
    "תפקיד, רקע, | מטרה, חומרים, | ומה לא."
   ],
   [
    17.6,
    19.85,
